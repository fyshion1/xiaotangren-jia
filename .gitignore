# Local secrets override — never commit
.env
app/config.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.uv/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Runtime data
*.db
*.sqlite3
# 只忽略运行期数据目录，别误伤前端源码 frontend/src/data/（源码里也有叫 data 的目录）
/data/
/backend/data/

# TTS voice models (large files — download on demand)
backend/data/tts/piper/

# 公网穿透的 cloudflared.exe（~50 MB，别进 git）
# start-tunnel.bat 找不到它会打印下载地址，重新下也就 20 秒。
/cloudflared.exe
cloudflared.exe

# Embedding models for memory RAG (large files — download on demand)
# 实际落点 backend/data/models/ 已被上面的 data/ 覆盖，这里再兜一层，换目录也不怕。
**/data/models/

# Models (large binary files — keep local only)
models/*.vrm
models/**/*.moc3
models/**/*.json
!models/.gitkeep

# Local design/reference assets (keep local only)
reference_picture/

# OS
.DS_Store
Thumbs.db
# Claude Code 本地设置（机器相关，不进 git）
.claude/settings.local.json
