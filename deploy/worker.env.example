# Set these as worker process environment variables; keep native backend/.env unchanged.
# start-worker.ps1 also reads the token from ignored backend/data/compute-worker.json.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=
WORKER_EMBEDDING_ENABLED=true
WORKER_IMAGES_ENABLED=false
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBED_LOCAL_DIR=
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=180
