# Copy to the separate deployment's backend/.env; never overwrite laptop .env.
HOST=0.0.0.0
PORT=8000
RUNTIME_PROFILE=lightweight
SERVE_FRONTEND=true
HARVEST_ENABLED=false
COMPUTE_MODE=native
# Switch to delegated after filling both values below (or save through UI).
COMPUTE_WORKER_URL=
COMPUTE_WORKER_TOKEN=
COMPUTE_CONNECT_TIMEOUT=2
COMPUTE_TASK_TIMEOUT=240
# Explicit external embedding API works in native and delegated modes.
EMBED_ENGINE=cloud
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_CLOUD_MODEL=text-embedding-3-small
MODEL_BASE_URL=https://example.com/v1
MODEL_API_KEY=
MODEL_CHAT=
MODEL_VISION=
