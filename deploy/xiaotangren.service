[Unit]
Description=Xiaotangren lightweight primary
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fyshion
WorkingDirectory=/opt/xiaotangren-jia/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xiaotangren-jia/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
