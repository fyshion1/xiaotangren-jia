# 小糖人之家 · 后端配置

# ===== 服务端 =====
HOST=127.0.0.1
PORT=8000

# ===== 模型来源（OpenAI 兼容，多路切换）=====
# 例：base_url 指 OpenAI 兼容端点（/v1）。中转/商业/Ollama 都适用。
#      Ollama 例：base_url=http://localhost:11434/v1  key=ollama
MODEL_BASE_URL=https://vsllm.cc/v1
MODEL_API_KEY=sk-your-key-here
MODEL_CHAT=gemini-3.8-flash
MODEL_VISION=gemini-3.8-flash
# 生图（可选）：vsllm 无生图通道，留空；另配生图中转时填 below
MODEL_IMAGE=
IMAGE_BASE_URL=
# 生图方式切换器（§7）：tencent（默认占位）| comfyui（本地 SD，未接入）| thirdparty
# 前端切换会存进数据库，这里只作默认值。
IMAGE_ENGINE=tencent

# ===== 记忆 RAG embedding（§9.2.1）=====
# 默认本地小模型（需先跑 download_embedding.sh，约 100MB）；也可切云端 /v1/embeddings。
# ⚠ local 与 cloud 的向量口径不同，换 engine 后必须重建记忆索引（§16.6）。
EMBED_ENGINE=local
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# EMBED_LOCAL_DIR=                # 留空 = backend/data/models/embedding
EMBED_CLOUD_MODEL=text-embedding-3-small
# EMBED_BASE_URL=                 # 留空 = 复用 MODEL_BASE_URL（key 复用 MODEL_API_KEY）

# ===== 可选：维护跨域域名（本地留空即可 / 逗号分隔）=====
CORS_ORIGINS=