# 小糖人之家 · 后端配置

# ===== 服务端 =====
HOST=127.0.0.1
PORT=8000

# ===== 模型来源（OpenAI 兼容，多路切换）=====
# 例：base_url 指 OpenAI 兼容端点（/v1）。中转/商业/Ollama 都适用。
#      Ollama 例：base_url=http://localhost:11434/v1  key=ollama
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_CHAT=
MODEL_VISION=
# 生图（可选）：按所选服务的文档填写，不使用时留空
MODEL_IMAGE=
IMAGE_BASE_URL=
# 生图方式切换器（§7）：local / cloud / thirdparty / novelai
# local & cloud 都是 ComfyUI，同一个 HTTP 协议；只是 base_url 不同。
# thirdparty = OpenAI 兼容 /images/generations；novelai = 预留插槽未实接。
IMAGE_ENGINE=local

# ===== 生图：ComfyUI 客户端（§7）=====
# 本地 ComfyUI 地址（默认 http://127.0.0.1:8188）
COMFYUI_URL=http://127.0.0.1:8188
# 云端 ComfyUI 地址（CNB / 其他转发）；填了它就能切到 cloud 引擎
COMFYUI_CLOUD_URL=
# API 格式工作流 json 路径；留空 = 用 examples/comfyui/ 里的内置示例
COMFYUI_WORKFLOW=
# 单张图的总预算（秒）
COMFYUI_TIMEOUT=180
# NovelAI 插槽（协议与 OpenAI 不兼容，见 providers/novelai.py）
NOVELAI_URL=
NOVELAI_API_KEY=

# ===== 记忆 RAG embedding（§9.2.1）=====
# 默认本地小模型（需先跑 download_embedding.sh，约 100MB）；也可切云端 /v1/embeddings。
# ⚠ local 与 cloud 的向量口径不同，换 engine 后必须重建记忆索引（§16.6）。
EMBED_ENGINE=local
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# EMBED_LOCAL_DIR=                # 留空 = backend/data/models/embedding
EMBED_CLOUD_MODEL=text-embedding-3-small
# EMBED_BASE_URL=                 # 含 /v1 的 API 根地址；留空 = 复用 MODEL_BASE_URL
# EMBED_API_KEY=                  # 独立密钥；仅复用聊天地址时可回退 MODEL_API_KEY

# ===== 可选：维护跨域域名（本地留空即可 / 逗号分隔）=====
CORS_ORIGINS=
# 可选的轻量主机与独立算力端；默认保留原生单机运行。
RUNTIME_PROFILE=full
COMPUTE_MODE=native
COMPUTE_WORKER_URL=
COMPUTE_WORKER_TOKEN=
COMPUTE_CONNECT_TIMEOUT=2
COMPUTE_TASK_TIMEOUT=120
SERVE_FRONTEND=false
# 仅 app.worker 使用；请在独立进程环境配置，不要覆盖原生设置。
WORKER_TOKEN=
WORKER_EMBEDDING_ENABLED=true
WORKER_IMAGES_ENABLED=false

