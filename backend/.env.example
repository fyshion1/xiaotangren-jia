# 小糖人之家 · 后端配置

# ===== 服务端 =====
HOST=127.0.0.1
PORT=8000

# ===== 模型来源（OpenAI 兼容，多路切换）=====
# 例：base_url 指 OpenAI 兼容端点（/v1）。中转/商业/Ollama 都适用。
#      Ollama 例：base_url=http://localhost:11434/v1  key=ollama
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-key-here
MODEL_CHAT=gemini-2.5-flash
MODEL_VISION=gemini-2.5-flash

# ===== 可选：维护跨域域名（本地留空即可 / 逗号分隔）=====
CORS_ORIGINS=